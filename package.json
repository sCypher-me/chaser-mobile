{
  "name": "chaser-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import:data": "tsx scripts/import/import-data.ts && node --experimental-strip-types scripts/import/translate-data.ts",
    "translate:data": "node --experimental-strip-types scripts/import/translate-data.ts",
    "validate:data": "tsx scripts/validation/validate-data.ts",
    "android:sync": "tsc -b && vite build && cap sync android",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 apk",
    "android:aab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 aab"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@tanstack/react-router": "^1.131.0",
    "dexie": "^4.2.0",
    "i18next": "^25.5.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^15.7.0",
    "zustand": "^5.0.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "adm-zip": "^0.5.16",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.2.5",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.1"
}
